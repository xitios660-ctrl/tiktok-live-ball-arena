# demo = simulated events (DEFAULT — no TikTok connection)
# production = real unofficial Webcast via tiktok-live-connector
TIKTOK_MODE=demo

# Host uniqueId without @ (PRODUCTION only)
TIKTOK_USERNAME=

# Optional Euler Stream sign API key (higher limits for PRODUCTION)
TIKTOK_SIGN_API_KEY=
# Alias:
# EULER_STREAM_API_KEY=

PORT=3000
HOST=0.0.0.0
ROUND_DURATION_SEC=300

# Likes global meter (every N likes → HEAL RAIN or SPEED STORM)
LIKE_THRESHOLD=100
LIKE_REWARD=heal_rain
# LIKE_REWARD=speed_storm

# Site password gate (production). When set, / /overlay /admin require unlock.
# Leave empty for local demo with no gate. Cookie arena_access after POST /access.
# OBS: unlock once in Browser Source, or open once with ?access_token=YOUR_PASSWORD
SITE_ACCESS_PASSWORD=
# WhatsApp for access requests (documented in access gate UI):
# https://wa.me/5511970731504
