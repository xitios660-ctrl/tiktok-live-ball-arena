# TikTok Live Ball Arena — environment template
# Copy to .env and adjust. Never commit real secrets.

# demo = simulated events (no TikTok connection)
# production = real connector (tiktok-live-connector behind abstract interface)
TIKTOK_MODE=demo

# Creator username without @ (used only when TIKTOK_MODE=production)
TIKTOK_USERNAME=

# Optional Euler Stream API key for higher rate limits / signing (production)
EULER_STREAM_API_KEY=

# HTTP + Socket.IO server
PORT=3000
HOST=0.0.0.0

# Optional DB (stub for later stages)
DATABASE_URL=postgresql://user:pass@localhost:5432/arena

# Round length in seconds (default 5 minutes)
ROUND_DURATION_SEC=300

# Client Vite dev server (proxy to API)
CLIENT_PORT=5173
